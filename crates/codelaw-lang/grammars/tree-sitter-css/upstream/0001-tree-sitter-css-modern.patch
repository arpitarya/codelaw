From 01ca281e0ea9e9544bd13a1fa99282b77a7ba56c Mon Sep 17 00:00:00 2001
From: Arpit <arpitarya.me@gmail.com>
Date: Sat, 24 Oct 2026 13:02:49 +0000
Subject: [PATCH] feat: range media features, `layer()` in `@import`,
 fractional keyframe selectors
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- range_query in _query: `(width >= 600px)`, `(400px <= width <= 700px)`,
  `(aspect-ratio > 16/9)` (Media Queries Level 4 range context)
- import_statement takes an optional `layer` / `layer(<name>)`
- keyframe_block accepts float_value (`12.5% { … }`)
- highlights: `<`, `<=`, `>=` as @operator
- test/corpus/modern.txt: six corpus tests
- src/ regenerated with tree-sitter-cli 0.25.10

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 grammar.js             |    57 +-
 queries/highlights.scm |     3 +
 src/grammar.json       |   326 +
 src/node-types.json    |    75 +
 src/parser.c           | 15400 +++++++++++++++++++++------------------
 test/corpus/modern.txt |   217 +
 6 files changed, 8993 insertions(+), 7085 deletions(-)
 create mode 100644 test/corpus/modern.txt

diff --git a/grammar.js b/grammar.js
index 4e7a49d..a11e28d 100644
--- a/grammar.js
+++ b/grammar.js
@@ -8,6 +8,8 @@
 /// <reference types="tree-sitter-cli/dsl" />
 // @ts-check
 
+const RANGE_OPERATORS = ['=', '<', '<=', '>', '>='];
+
 export default grammar({
   name: 'css',
 
@@ -49,10 +51,24 @@ export default grammar({
     import_statement: $ => seq(
       '@import',
       $._value,
+      optional($._import_layer),
       sep(',', $._query),
       ';',
     ),
 
+    // `layer` or `layer(name)` after the URL of an `@import`
+    // (CSS Cascading and Inheritance Level 5). A bare `layer` keeps the
+    // `keyword_query` node it has always parsed as.
+    _import_layer: $ => choice(
+      alias('layer', $.keyword_query),
+      alias($._import_layer_function, $.call_expression),
+    ),
+
+    _import_layer_function: $ => seq(
+      alias('layer', $.function_name),
+      $.arguments,
+    ),
+
     media_statement: $ => seq(
       '@media',
       sep1(',', $._query),
@@ -88,7 +104,7 @@ export default grammar({
     ),
 
     keyframe_block: $ => seq(
-      sep1(',', choice($.from, $.to, $.integer_value)),
+      sep1(',', choice($.from, $.to, $.integer_value, $.float_value)),
       $.block,
     ),
 
@@ -326,6 +342,7 @@ export default grammar({
     _query: $ => choice(
       alias($.identifier, $.keyword_query),
       $.feature_query,
+      $.range_query,
       $.binary_query,
       $.unary_query,
       $.selector_query,
@@ -340,6 +357,44 @@ export default grammar({
       ')',
     ),
 
+    // A range media feature (Media Queries Level 4): `(width >= 600px)`,
+    // `(600px <= width)`, `(400px < width <= 700px)`.
+    range_query: $ => seq(
+      '(',
+      choice(
+        seq(alias($.identifier, $.feature_name), choice(...RANGE_OPERATORS), $._range_value),
+        seq($._range_value, choice(...RANGE_OPERATORS), alias($.identifier, $.feature_name)),
+        seq(
+          $._range_value,
+          choice('<', '<='),
+          alias($.identifier, $.feature_name),
+          choice('<', '<='),
+          $._range_value,
+        ),
+        seq(
+          $._range_value,
+          choice('>', '>='),
+          alias($.identifier, $.feature_name),
+          choice('>', '>='),
+          $._range_value,
+        ),
+      ),
+      ')',
+    ),
+
+    _range_value: $ => choice(
+      $.integer_value,
+      $.float_value,
+      $.call_expression,
+      alias($._ratio, $.binary_expression),
+    ),
+
+    _ratio: $ => seq(
+      choice($.integer_value, $.float_value),
+      '/',
+      choice($.integer_value, $.float_value),
+    ),
+
     parenthesized_query: $ => seq(
       '(',
       $._query,
